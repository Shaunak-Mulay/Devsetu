# ==============================================================================
# DEVSETU CONNECT SERVER CONFIGURATION
# ==============================================================================

# Server Port
PORT=5000

# Supabase Database & Storage Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Direct PostgreSQL Connection URL (Optional, for direct pg pooling or migrations)
DATABASE_URL=postgresql://postgres.your-project:yourpassword@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# JWT Secret for API Authentication
JWT_SECRET=devsetu-super-secret-jwt-key-change-in-production

# Production Admin Seed Credentials
ADMIN_EMAIL=devsetuconnect@gmail.com
ADMIN_PASSWORD=AdminP@ss123!
DEFAULT_ASTRO_PIN=000000

# SMTP (Email / Brevo / SendGrid) Configuration
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@devsetu.in
SMTP_FROM_NAME=DevSetu Connect
EMAIL_ENABLED=true

# Twilio / Msg91 (SMS) Configuration
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
SMS_ENABLED=false
SMS_PROVIDER=mock

# Firebase / Push Notification Configuration (FCM)
FCM_SERVER_KEY=
FIREBASE_API_KEY=
FIREBASE_DATABASE_URL=

# Support Contact
SUPPORT_PHONE=+91 97631 47067
SUPPORT_EMAIL=devsetuconnect@gmail.com
